  cd <- data.frame(x = pj[,1], y = pj[,2])
  cat("  Moran's I neighbours computed in", UTM_CRS, "\n")
}
moran_res <- dplyr::bind_rows(c(
  lapply(MODEL_NAMES, function(m) morans_test(m, sc_main$dat$presence, sc_main$oof[, m], cd)),
  list(morans_test("Ensemble", sc_main$dat$presence, sc_main$ens_oof, cd))))
