cat("\nEstimating spatial-autocorrelation range of predictors...\n")

# Internal fallback estimator: empirical semivariogram of ONE predictor layer in a projected CRS,
# spherical model fitted by nls; returns the fitted range (metres). Predictors only.
own_range <- function(r1, n = 3000, nbins = 20, seed = 1) {
  tryCatch({
    set.seed(seed)
    smp <- terra::spatSample(r1, n, method = "random", na.rm = TRUE, xy = TRUE, values = TRUE)
    if (nrow(smp) < 300) return(list(range = NA_real_, flag = "too few cells"))
    xy <- if (is.lonlat(r1)) crds(project(vect(smp[, c("x","y")], geom = c("x","y"), crs = crs(r1)), UTM_CRS))
    else as.matrix(smp[, c("x","y")])
    z <- as.numeric(smp[[3]]); if (sd(z) == 0) return(list(range = NA_real_, flag = "constant layer"))
    z <- (z - mean(z)) / sd(z)
    d <- as.numeric(dist(xy)); g <- as.numeric(0.5 * dist(z)^2)
    cutoff <- max(d) / 3
    keep <- d > 0 & d <= cutoff
    b <- cut(d[keep], breaks = seq(0, cutoff, length.out = nbins + 1), include.lowest = TRUE)
    vg <- data.frame(h = tapply(d[keep], b, mean), gamma = tapply(g[keep], b, mean))
    vg <- vg[complete.cases(vg), ]
    sph <- function(h, nug, sill, a) ifelse(h < a, nug + (sill - nug) * (1.5 * h / a - 0.5 * (h / a)^3), sill)
    fit <- nls(gamma ~ sph(h, nug, sill, a), data = vg,
               start = list(nug = 0.05, sill = max(vg$gamma), a = cutoff / 2),
               algorithm = "port", lower = c(0, 0, min(vg$h)), upper = c(2, 3, cutoff))
    a <- as.numeric(coef(fit)["a"])
    flag <- if (a >= 0.98 * cutoff) "at upper bound (sill not reached within cutoff; range unreliable)"
    else if (a <= 1.02 * min(vg$h)) "at lower bound (range unreliable)" else "ok"
    list(range = a, flag = flag)
  }, error = function(e) list(range = NA_real_, flag = paste("fit failed:", substr(e$message, 1, 80))))
}

ext_diag <- sqrt((ev_utm[2] - ev_utm[1])^2 + (ev_utm[4] - ev_utm[3])^2)   # study-area diagonal (m)

est_block_size <- function() {
  lay <- names(env)
  stat <- data.frame(Layer = lay, blockCV_stack_m = NA_real_, blockCV_layer_m = NA_real_,
                     internal_variogram_m = NA_real_, blockCV_layer_error = NA_character_)
  finish <- function(rng, source) list(size = median(rng, na.rm = TRUE), source = source, stat = stat, ranges = rng,
                                       n_ok = sum(is.finite(rng)))
  min_ok <- max(3, ceiling(length(lay) / 2))
  
  # Tier 1: blockCV on the whole predictor stack
  t1 <- tryCatch(blockCV::cv_spatial_autocor(r = env, num_sample = 5000, plot = FALSE, progress = FALSE),
                 error = function(e) { cat("  Tier 1 (stack) failed:", e$message, "\n"); NULL })
  if (!is.null(t1) && is.finite(as.numeric(t1$range))) {
    rt <- t1$range_table
    if (!is.null(rt)) { stat$blockCV_stack_m[match(as.character(rt[[1]]), lay)] <- rt[[ncol(rt)]]
    write.csv(rt, paste0(out, "Autocorrelation_range_table.csv"), row.names = FALSE) }
    return(c(finish(if (!is.null(rt)) rt[[ncol(rt)]] else as.numeric(t1$range),
                    "cv_spatial_autocor() on predictor stack"), list(size_override = as.numeric(t1$range))))
  }
  # Tier 2: blockCV layer by layer (isolates problem layers)
  for (k in seq_along(lay)) {
    stat$blockCV_layer_m[k] <- tryCatch(
      as.numeric(blockCV::cv_spatial_autocor(r = env[[k]], num_sample = 5000, plot = FALSE,
                                             progress = FALSE)$range),
      error = function(e) { stat$blockCV_layer_error[k] <<- substr(e$message, 1, 120); NA_real_ })
  }
  stat$blockCV_layer_raw_m <- stat$blockCV_layer_m
  bad <- is.finite(stat$blockCV_layer_m) & stat$blockCV_layer_m > ext_diag     # range larger than the study area: not usable
  if (any(bad)) cat("  Tier 2: discarding layer ranges > study-area diagonal:", paste(lay[bad], collapse = ", "), "\n")
  stat$blockCV_layer_m[bad] <- NA
  if (sum(is.finite(stat$blockCV_layer_m)) >= min_ok) {
    write.csv(stat, paste0(out, "Autocorrelation_range_table.csv"), row.names = FALSE)
    return(finish(stat$blockCV_layer_m, sprintf("cv_spatial_autocor() per layer (median of %d/%d layers)",
                                                sum(is.finite(stat$blockCV_layer_m)), length(lay))))
  }
  # Tier 3: internal empirical-variogram estimator
  cat("  Tier 2 insufficient; using internal variogram estimator\n")
  ov <- lapply(seq_along(lay), function(k) own_range(env[[k]]))
  stat$internal_variogram_m <- sapply(ov, function(o) o$range)
  stat$internal_flag        <- sapply(ov, function(o) o$flag)
  print(stat[, c("Layer", "internal_variogram_m", "internal_flag")])
  write.csv(stat, paste0(out, "Autocorrelation_range_table.csv"), row.names = FALSE)
  if (sum(is.finite(stat$internal_variogram_m)) >= min_ok)
    return(finish(stat$internal_variogram_m, sprintf("internal spherical-variogram fit per layer (median of %d/%d layers)",
                                                     sum(is.finite(stat$internal_variogram_m)), length(lay))))
  write.csv(stat, paste0(out, "Autocorrelation_range_table.csv"), row.names = FALSE)
  list(size = NA_real_, source = "none (all autocorrelation estimators failed)", stat = stat, n_ok = 0)
}

