sample_bg <- function(w_rast, n, src, seed) {
  set.seed(seed)
  wv <- values(w_rast, mat = FALSE)
  ok <- which(!is.na(wv) & wv > 0)
  idx <- sample(ok, n, replace = FALSE, prob = wv[ok])
  xy  <- xyFromCell(w_rast, idx)
  pv  <- vect(xy, type = "points", crs = crs(env))
  ev  <- terra::extract(env, pv)[, -1]
  data.frame(x = xy[,1], y = xy[,2], presence = 0, src = src, ev)
}

