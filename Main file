get_importance <- function(fm, vars) {
  L <- list()
  if (!is.null(fm$glm)) {
    cf <- abs(coef(fm$glm)[-1]); cf <- cf[!is.na(cf)]
    L$GLM <- data.frame(Model = "GLM", Variable = names(cf), Raw = as.numeric(cf))
  }
  if (!is.null(fm$rf)) {
    ri <- importance(fm$rf)
    col <- intersect(c("MeanDecreaseAccuracy", "MeanDecreaseGini"), colnames(ri))[1]
    L$RF <- data.frame(Model = "RF", Variable = rownames(ri), Raw = as.numeric(ri[, col]))
  }
  if (!is.null(fm$brt)) {
    s <- summary(fm$brt, n.trees = fm$brt_n, plotit = FALSE)
    L$BRT <- data.frame(Model = "BRT", Variable = as.character(s$var), Raw = s$rel.inf)
  }
  if (!is.null(fm$mars)) tryCatch({
    ev <- unclass(evimp(fm$mars))
    L$MARS <- data.frame(Model = "MARS", Variable = gsub("-unused$", "", rownames(ev)),
                         Raw = as.numeric(ev[, "nsubsets"]))
  }, error = function(e) NULL)
  if (!is.null(fm$mx)) tryCatch({
    rs <- fm$mx@results; rn <- grep("permutation.importance", rownames(rs), value = TRUE)
    L$MaxEnt <- data.frame(Model = "MaxEnt",
                           Variable = sub("\\.permutation\\.importance$", "", rn),
                           Raw = as.numeric(rs[rn, 1]))
  }, error = function(e) NULL)
  dplyr::bind_rows(L) %>% dplyr::filter(Variable %in% vars, !is.na(Raw)) %>%
    dplyr::group_by(Model) %>% dplyr::mutate(RelImp = 100 * Raw / max(Raw, na.rm = TRUE)) %>%
    dplyr::arrange(Model, desc(RelImp)) %>% dplyr::mutate(Rank = dplyr::row_number()) %>%
    dplyr::ungroup()
}

