    geom_ribbon(aes(ymin = lower, ymax = upper), fill = col, alpha = 0.2) +
    geom_line(colour = col, linewidth = 1.1) +
    facet_wrap(~Variable, scales = "free_x", ncol = 3) +
    labs(title = title_str, subtitle = "Shaded = 95% bootstrap CI (n=50 resamples)",
         x = "Predictor value (standardised)", y = "Relative suitability index") +
    theme_bw(base_size = 13) + theme(strip.text = element_text(face = "bold"), plot.title = element_text(face = "bold"))
  save_gg(p, paste0(out, fname), 10, 2.8 * nr)
}

manual_pdp <- function(model, predict_fn, data_pred, var_list, n_pts = 100, model_name, col) {
  data_pred <- as.data.frame(data_pred); pd <- list()
  for (v in var_list) {
    vr <- range(data_pred[[v]], na.rm = TRUE); if (diff(vr) == 0) next
    g <- seq(vr[1], vr[2], length.out = n_pts)
    yhat <- sapply(g, function(val) { tmp <- data_pred; tmp[[v]] <- val
    mean(tryCatch(predict_fn(model, tmp), error = function(e) NA_real_), na.rm = TRUE) })
    pd[[v]] <- data.frame(Variable = v, x = g, yhat = yhat)
  }
  if (length(pd) == 0) return(invisible())
  pd_all <- dplyr::bind_rows(pd); nr <- ceiling(length(pd) / 3)
  write.csv(data.frame(Variable = pd_all$Variable, x = pd_all$x, mean = pd_all$yhat, lower = NA_real_, upper = NA_real_),
            paste0(out, "Response_curves_", model_name, "_data.csv"), row.names = FALSE)   # for figure script
  p <- ggplot(pd_all, aes(x, yhat)) + geom_line(colour = col, linewidth = 1.1) +
    geom_rug(sides = "b", colour = "grey60", alpha = 0.3, linewidth = 0.3) +
    facet_wrap(~Variable, scales = "free_x", ncol = 3) +
    labs(title = paste(model_name, "— Partial Dependence Plots"),
         subtitle = paste0("Marginal effect across ", nrow(data_pred), " training rows"),
         x = "Predictor value (standardised)", y = "Relative suitability index") +
    theme_bw(base_size = 13) + theme(strip.text = element_text(face = "bold"), plot.title = element_text(face = "bold"))
  save_gg(p, paste0(out, "Response_curves_", model_name, ".png"), 10, 2.8 * nr)
}

