scenario_metrics <- function(sc, imp) {
  ens <- sc$ens_wt; sdr <- sc$ens_sd; thr <- sc$ens_thr
  mean_auc <- if (nrow(sc$results) > 0) tapply(sc$results$AUC, sc$results$Model, mean) else NULL
  mean_tss <- if (nrow(sc$results) > 0) tapply(sc$results$TSS_opt, sc$results$Model, mean) else NULL
  m <- c(setNames(round(mean_auc, 3), paste0("AUC_", names(mean_auc))),
         setNames(round(mean_tss, 3), paste0("TSS_opt_", names(mean_tss))),
         Ensemble_OOF_AUC = round(sc$ens_perf$auc, 3),
         Ensemble_TSS_at_optimised_threshold = round(sc$ens_perf$tss, 3),
         Ensemble_OOF_AUC_field_only = round(sc$ens_perf_field$auc, 3),
         Ensemble_threshold = round(thr, 3),
         Suitable_area_km2 = area_km2(ens >= thr),
         High_suitability_area_km2 = area_km2(ens >= HIGH_SUIT),
         Priority_area_km2 = area_km2(ens >= HIGH_SUIT & sdr < SD_PRIMARY))
  tp <- imp %>% dplyr::filter(Rank == 1)
  c(as.list(m), Top_predictors = paste(paste0(tp$Model, ":", tp$Variable), collapse = "; "))
}
