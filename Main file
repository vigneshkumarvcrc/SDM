      pv[cc] <- as.numeric(predict(fm_final$mx, vdf[cc, , drop = FALSE]))
      r <- setValues(env[[1]], pv)
    }
    r
  })
  if (length(maps) < 2) stop("Fewer than 2 model maps produced")
  ens <- make_ensemble(maps, w_full)
  ens_wt <- mask(ens$wt, vect(wg)); ens_sd <- mask(ens$sd, vect(wg)); ens_mn <- mask(ens$mean, vect(wg))
  writeRaster(ens_mn, paste0(dir, "Map_Ensemble_mean.tif"),     overwrite = TRUE)
  writeRaster(ens_wt, paste0(dir, "Map_Ensemble_weighted.tif"), overwrite = TRUE)
  writeRaster(ens_sd, paste0(dir, "Map_InterModel_Disagreement_SD.tif"), overwrite = TRUE)
  
  list(tag = tag, dir = dir, dat = dat, folds = folds, block_size = actual_size,
       results = results, roc = roc_all, oof = oof, w_full = w_full, ens_oof = ens_oof,
