omission_rate <- function(obs, pred, threshold) {
  pres <- obs == 1
  if (sum(pres) == 0) return(NA_real_)
  1 - mean(as.integer(pred[pres] >= threshold))
}
brt_ntrees <- function(mod, requested = 2000) {
  actual <- tryCatch(mod$n.trees, error = function(e) requested)
  min(requested, actual)
}
safe_pred <- function(expr, n) tryCatch(expr, error = function(e) rep(NA_real_, n))
try_fit   <- function(expr, nm) tryCatch(expr, error = function(e) { cat("   ", nm, "failed:", e$message, "\n"); NULL })

# Fold-internal preprocessing: VIF + scaling from TRAINING rows only (R1)
prep_fold <- function(train_df, test_df) {
  vif_res <- usdm::vifstep(train_df[, ALL_VARS], th = 5)
  v   <- as.character(vif_res@results$Variables)
  mu  <- colMeans(train_df[, v, drop = FALSE], na.rm = TRUE)
  sdv <- apply(train_df[, v, drop = FALSE], 2, sd, na.rm = TRUE)
  keep <- sdv > 0
  if (any(!keep)) cat("    Zero SD dropped:", paste(v[!keep], collapse = ", "), "\n")
  v <- v[keep]; mu <- mu[v]; sdv <- sdv[v]
  sc <- function(df) {
    o <- df[, v, drop = FALSE]
    for (nm in v) o[[nm]] <- (o[[nm]] - unname(mu[nm])) / unname(sdv[nm])
    o
  }
  list(vars = v, mu = mu, sd = sdv, vif = vif_res,
       train_sc = cbind(presence = train_df$presence, sc(train_df)),
       test_sc  = cbind(presence = test_df$presence,  sc(test_df)))
}

fit_models <- function(train_sc, train_raw, vars, mx_dir, full = FALSE) {
  dir.create(mx_dir, showWarnings = FALSE, recursive = TRUE)
  mx_args <- c("outputformat=logistic", "betamultiplier=1", "threads=2",
               if (full) c("responsecurves=true", "jackknife=true"))
  fm <- list(
    glm  = try_fit(glm(presence ~ ., data = train_sc, family = binomial), "GLM"),
    rf   = try_fit(randomForest(as.factor(presence) ~ ., data = train_sc,
                                importance = TRUE, ntree = 500), "RF"),
    brt  = try_fit(gbm(presence ~ ., data = train_sc, distribution = "bernoulli",
                       n.trees = 2000, interaction.depth = 3, shrinkage = 0.01,
                       bag.fraction = 0.75, verbose = FALSE), "BRT"),
    mars = try_fit(earth(presence ~ ., data = train_sc,
                         glm = list(family = binomial), degree = 2, nprune = 15), "MARS"),
    # MaxEnt uses RAW predictor units (documented) and no coordinates
    mx   = try_fit(maxent(x = train_raw[, vars, drop = FALSE], p = train_sc$presence,
                          path = mx_dir, args = mx_args), "MaxEnt"))
  fm$brt_n <- if (!is.null(fm$brt)) brt_ntrees(fm$brt) else NA
  fm
}

predict_models <- function(fm, sc_df, raw_df, vars) {
  n <- nrow(sc_df); p <- setNames(vector("list", 5), MODEL_NAMES)
  na <- rep(NA_real_, n)
  p$GLM  <- if (!is.null(fm$glm))  safe_pred(as.numeric(predict(fm$glm, sc_df, type = "response")), n) else na
  p$RF   <- if (!is.null(fm$rf))   safe_pred(as.numeric(predict(fm$rf, sc_df, type = "prob")[, "1"]), n) else na
  p$BRT  <- if (!is.null(fm$brt))  safe_pred(as.numeric(predict(fm$brt, sc_df, n.trees = fm$brt_n, type = "response")), n) else na
  p$MARS <- if (!is.null(fm$mars)) safe_pred(as.numeric(predict(fm$mars, sc_df, type = "response")), n) else na
  p$MaxEnt <- if (!is.null(fm$mx)) safe_pred(as.numeric(predict(fm$mx, raw_df[, vars, drop = FALSE])), n) else na
  p
}

eval_metrics <- function(obs, pred, model, fold) {
  valid <- !is.na(pred) & !is.na(obs); pred <- pred[valid]; obs <- obs[valid]
  if (length(unique(obs)) < 2 || sum(obs == 1) < MIN_PRES_FOLD || length(obs) < 10) return(NULL)
  roc_obj <- tryCatch(pROC::roc(obs, pred, levels = c(0L, 1L), direction = "<",
                                ci = TRUE, quiet = TRUE), error = function(e) NULL)
  if (is.null(roc_obj)) return(NULL)
  best <- tryCatch(pROC::coords(roc_obj, "best", ret = c("threshold","sensitivity","specificity"),
                                transpose = FALSE), error = function(e) NULL)
  if (is.null(best) || nrow(best) == 0) return(NULL)
  ci  <- as.numeric(pROC::ci(roc_obj))
  sens <- best$sensitivity[1]; spec <- best$specificity[1]; thr <- best$threshold[1]
  pb <- factor(as.integer(pred >= thr), levels = c(0L, 1L)); ob <- factor(obs, levels = c(0L, 1L))
  cm <- tryCatch(caret::confusionMatrix(pb, ob, positive = "1"), error = function(e) NULL)
  row <- data.frame(Model = model, Fold = fold,
                    AUC = round(as.numeric(pROC::auc(roc_obj)), 4),
                    AUC_lower = round(ci[1], 4), AUC_upper = round(ci[3], 4),
                    Sensitivity = round(sens, 4), Specificity = round(spec, 4),
                    TSS_opt = round(sens + spec - 1, 4),   # threshold optimised on same predictions: NOT independent
                    
                    OmissionRate = round(omission_rate(obs, pred, thr), 4),
                    Kappa = round(if (!is.null(cm)) as.numeric(cm$overall["Kappa"]) else NA_real_, 4),
                    Threshold = round(thr, 4))
  rc <- tryCatch(pROC::ci.se(roc_obj, specificities = seq(0, 1, 0.01), quiet = TRUE),
                 error = function(e) NULL)
  roc_df <- if (!is.null(rc)) data.frame(Model = model, Fold = fold,
                                         Specificity = seq(0, 1, 0.01),
                                         Se_lower = rc[,1], Sensitivity = rc[,2],
                                         Se_upper = rc[,3]) else NULL
  list(row = row, roc = roc_df)
}

ens_eval <- function(obs, pred) {
  ok <- !is.na(pred)
  if (sum(ok) < 10 || length(unique(obs[ok])) < 2) return(list(auc = NA, tss = NA, thr = NA))
  r <- pROC::roc(obs[ok], pred[ok], levels = c(0, 1), direction = "<", quiet = TRUE)
  b <- pROC::coords(r, "best", ret = c("threshold","sensitivity","specificity"), transpose = FALSE)
  list(auc = as.numeric(pROC::auc(r)), tss = b$sensitivity[1] + b$specificity[1] - 1,
       thr = b$threshold[1])
}

`%||%` <- function(x, y) if (is.null(x)) y else x   # defined explicitly (not relying on base R >= 4.4)

oof_ensemble <- function(oof, w, exclude = NULL) {
  w2 <- w[colnames(oof)]
  if (!is.null(exclude)) w2[colnames(oof) %in% exclude] <- 0
  apply(oof, 1, function(x) {
    ok <- !is.na(x) & w2 > 0
    if (!any(ok)) NA_real_ else sum(x[ok] * w2[ok]) / sum(w2[ok])
  })
}

# Leave-one-fold-out weights: weights for fold i use AUCs from the OTHER folds only
lofo_weights <- function(results, i) {
  w <- setNames(rep(0, 5), MODEL_NAMES)
  r <- results[results$Fold != i, ]
  if (nrow(r) > 0) { wm <- tapply(r$AUC, r$Model, mean, na.rm = TRUE); w[names(wm)] <- wm }
  if (sum(w) == 0) w[] <- 1
  w
}
oof_ensemble_lofo <- function(oof, folds, results, exclude = NULL) {
  o <- rep(NA_real_, nrow(oof))
  for (i in sort(unique(folds))) {
    te <- which(folds == i)
    o[te] <- oof_ensemble(oof[te, , drop = FALSE], lofo_weights(results, i), exclude)
  }
  o
}

make_ensemble <- function(maps, w, exclude = NULL) {
  nm <- setdiff(names(maps), exclude)
  ww <- w[nm]; if (sum(ww) == 0) ww[] <- 1; ww <- ww / sum(ww)
  stk <- rast(maps[nm])
  wt  <- Reduce("+", lapply(seq_along(nm), function(i) maps[[nm[i]]] * as.numeric(ww[i])))
  list(wt = wt, mean = app(stk, mean, na.rm = TRUE), sd = app(stk, sd, na.rm = TRUE),
       weights = ww)
}


# ============================================================================
# 14. SCENARIO RUNNER  (spatial CV with leakage-free preprocessing,
#     OOF predictions, final models, maps, ensemble)
# ============================================================================

run_scenario <- function(dat, tag, dir, plot_cv = FALSE) {
  dir.create(dir, showWarnings = FALSE, recursive = TRUE)
  cat("\n==== Scenario:", tag, "| rows:", nrow(dat), "====\n")
  set.seed(2026)
  n <- nrow(dat)
  is_field <- dat$src %in% c("Field presence", "Field non-detection")
  
  # ---- spatial folds FIRST (on raw data) ----
  pts_sf <- st_as_sf(dat[, c("x","y","presence")], coords = c("x","y"), crs = crs(env))
  sizes  <- if (is.finite(block_size_m)) block_size_m * c(1, 0.5, 0.25) else NA_real_
  sb <- NULL; used_size <- NA_real_; attempted <- numeric(0)
  for (s in sizes) {
    attempted <- c(attempted, s)
    sb <- tryCatch(
      if (is.na(s)) cv_spatial(x = pts_sf, column = "presence", r = env, k = 5,
                               selection = "random", iteration = 100, biomod2 = FALSE,
                               progress = FALSE, report = FALSE, plot = FALSE)
      else          cv_spatial(x = pts_sf, column = "presence", size = s, k = 5,
                               selection = "random", iteration = 100, biomod2 = FALSE,
                               progress = FALSE, report = FALSE, plot = FALSE),
      error = function(e) { cat("  cv_spatial failed at size", round(s/1000, 1), "km:", e$message, "\n"); NULL })
    if (!is.null(sb)) { used_size <- s; break }
  }
  if (is.null(sb)) stop("cv_spatial() failed for all block sizes")
  folds <- sb$folds_ids
  if (is.null(folds) || length(folds) != n || any(is.na(folds)) || any(folds == 0))
    stop("Some observations were not assigned to spatial CV folds — investigate blockCV output.")
  actual_size <- if (is.finite(used_size)) used_size else tryCatch(as.numeric(sb$size)[1], error = function(e) NA_real_)
  cat("  Block size used:", round(actual_size / 1000, 2), "km | method:", BLOCK_METHOD_USED, "\n")
  print(table(Fold = folds, Presence = dat$presence))
  write.csv(data.frame(autocorr_range_m = block_size_m,
                       autocorr_range_km = round(block_size_m / 1000, 2),
                       attempted_sizes_km = paste(round(attempted / 1000, 2), collapse = " -> "),
                       block_size_m = actual_size, block_size_km = round(actual_size/1000, 2),
                       fallback_used = is.finite(block_size_m) && !isTRUE(all.equal(used_size, block_size_m)),
                       autocorr_derived = is.finite(block_size_m),
                       block_size_source = block_src,
                       size_factor_used = round(actual_size / block_size_m, 3),
                       buffer_m_applied = BUFFER_M,
                       buffer_note = ifelse(BUFFER_M > 0, "per fold, training points within buffer of any test point were removed",
                                            "NO exclusion buffer: blocks separate folds but nearest train-test distance can be < block size (see CV_fold_separation.csv)"),
                       method = BLOCK_METHOD_USED),
            paste0(dir, "CV_block_size.csv"), row.names = FALSE)
  if (plot_cv) tryCatch({
    save_gg(cv_plot(sb, x = pts_sf, r = raster::stack(env)), paste0(dir, "SpatialBlock_CV_map.png"), 7, 8)
  }, error = function(e) cat("  cv_plot skipped:", e$message, "\n"))
  
  fold_comp <- do.call(rbind, lapply(1:5, function(i) data.frame(
    Fold = i,
    Train_pres = sum(dat$presence[folds != i] == 1), Train_zero = sum(dat$presence[folds != i] == 0),
    Test_pres  = sum(dat$presence[folds == i] == 1), Test_zero  = sum(dat$presence[folds == i] == 0))))
  write.csv(fold_comp, paste0(dir, "CV_fold_composition.csv"), row.names = FALSE)
  
  # distance matrix (projected metres) for buffering + separation diagnostics
  xyp <- if (is.lonlat(env)) crds(project(vect(dat[, c("x","y")], geom = c("x","y"), crs = crs(env)), UTM_CRS))
  else as.matrix(dat[, c("x","y")])
  Dm  <- as.matrix(dist(xyp))
  train_used <- vector("list", 5)
  
  # ---- CV loop ----
  results <- data.frame(); roc_all <- data.frame(); fold_vars <- data.frame(); fold_status <- data.frame()
  oof <- matrix(NA_real_, n, 5, dimnames = list(NULL, MODEL_NAMES))
  
  for (i in 1:5) {
    cat("\n  -- Fold", i, "--\n")
    tr <- which(folds != i); te <- which(folds == i)
    n_purged <- 0
    if (BUFFER_M > 0) {
      dmin <- apply(Dm[tr, te, drop = FALSE], 1, min)
      n_purged <- sum(dmin < BUFFER_M); tr <- tr[dmin >= BUFFER_M]
      cat("    Buffer", BUFFER_M / 1000, "km: purged", n_purged, "training rows\n")
    }
    train_used[[i]] <- tr
    train_raw <- dat[tr, ]; test_raw <- dat[te, ]
    cat("    Train pres/zero:", sum(train_raw$presence == 1), "/", sum(train_raw$presence == 0),
        "| Test pres/zero:", sum(test_raw$presence == 1), "/", sum(test_raw$presence == 0), "\n")
    if (length(unique(train_raw$presence)) < 2 || length(unique(test_raw$presence)) < 2 ||
        sum(train_raw$presence == 1) < MIN_PRES_FOLD || sum(test_raw$presence == 1) < MIN_PRES_FOLD) {
      cat("    SKIP fold (insufficient classes/presences)\n")
      fold_status <- rbind(fold_status, data.frame(Fold = i, Status = "SKIPPED",
                                                   Reason = paste0("train pres=", sum(train_raw$presence == 1), ", train zero=", sum(train_raw$presence == 0),
                                                                   ", test pres=", sum(test_raw$presence == 1), ", test zero=", sum(test_raw$presence == 0),
                                                                   " (need both classes and >= ", MIN_PRES_FOLD, " presences in train and test)")))
      next }
    fold_status <- rbind(fold_status, data.frame(Fold = i, Status = "RUN", Reason = paste0("training rows purged by buffer: ", n_purged)))
    
    pf <- prep_fold(train_raw, test_raw)               # training-only VIF + scaling
    cat("    Fold VIF-retained:", paste(pf$vars, collapse = ", "), "\n")
    fold_vars <- rbind(fold_vars, data.frame(Fold = i, Variables = paste(pf$vars, collapse = ", ")))
    
    fm    <- fit_models(pf$train_sc, train_raw, pf$vars, paste0(dir, "maxent_cv/fold_", i, "/"))
    preds <- predict_models(fm, pf$test_sc, test_raw, pf$vars)
    
    for (m in MODEL_NAMES) {
      oof[te, m] <- preds[[m]]
      em <- eval_metrics(as.integer(test_raw$presence), preds[[m]], m, i)
      if (is.null(em)) { cat("    Skip metrics [", m, "]\n"); next }
      results <- rbind(results, em$row)
      if (!is.null(em$roc)) roc_all <- rbind(roc_all, em$roc)
    }
  }
  write.csv(results,   paste0(dir, "Model_metrics_per_fold.csv"), row.names = FALSE)
  write.csv(roc_all,   paste0(dir, "ROC_data_all_folds.csv"),     row.names = FALSE)
  write.csv(fold_vars, paste0(dir, "CV_fold_VIF_variables.csv"),  row.names = FALSE)
  
  # ---- CV diagnostics (Issue D) ----
  write.csv(fold_status[order(fold_status$Fold), ], paste0(dir, "CV_fold_status.csv"), row.names = FALSE)
  if (any(fold_status$Status != "RUN"))
    cat("  WARNING: folds not run:", paste(fold_status$Fold[fold_status$Status != "RUN"], collapse = ", "),
        "- their rows have NO out-of-fold prediction (see CV_fold_status.csv)\n")
  
  validity <- data.frame(
    Model = MODEL_NAMES,
    n_oof_valid = as.integer(colSums(!is.na(oof))),
    pct_rows_valid = round(100 * colMeans(!is.na(oof)), 1),
    folds_with_metrics = sapply(MODEL_NAMES, function(m) length(unique(results$Fold[results$Model == m]))),
    oof_min = suppressWarnings(round(apply(oof, 2, min, na.rm = TRUE), 4)),
    oof_max = suppressWarnings(round(apply(oof, 2, max, na.rm = TRUE), 4)),
    oof_sd  = round(apply(oof, 2, sd, na.rm = TRUE), 4))
  validity$Flag <- ifelse(validity$folds_with_metrics < sum(fold_status$Status == "RUN"), "MODEL MISSING IN SOME FOLDS",
                          ifelse(!is.finite(validity$oof_sd) | validity$oof_sd < 1e-6, "CONSTANT PREDICTIONS",
                                 ifelse(validity$oof_min < 0 | validity$oof_max > 1, "OUTSIDE [0,1]", "ok")))
  cat("\n  === OOF PREDICTION VALIDITY ===\n"); print(validity, row.names = FALSE)
  write.csv(validity, paste0(dir, "CV_prediction_validity.csv"), row.names = FALSE)
  
  # fold separation: distance from each test point to nearest TRAINING point (projected metres)
  sep <- do.call(rbind, lapply(1:5, function(i) {
    te <- which(folds == i); tr <- if (!is.null(train_used[[i]])) train_used[[i]] else which(folds != i)
    nn <- apply(Dm[te, tr, drop = FALSE], 1, min)
    data.frame(Fold = i, n_test = length(te), NN_min_km = round(min(nn) / 1000, 2),
               NN_p10_km = round(quantile(nn, 0.10) / 1000, 2), NN_median_km = round(median(nn) / 1000, 2),
               Prop_test_with_training_point_within_block = round(mean(nn < actual_size), 3))
  }))
  cat("\n  === FOLD SEPARATION (nearest training point to each test point) ===\n"); print(sep, row.names = FALSE)
  write.csv(sep, paste0(dir, "CV_fold_separation.csv"), row.names = FALSE)
  rm(Dm)
  write.csv(data.frame(dat[, c("x","y","presence","src")], folds = folds, oof),
            paste0(dir, "OOF_predictions.csv"), row.names = FALSE)
  
  # ---- ensemble weights + OOF ensemble + ensemble threshold (R13) ----
  w_full <- setNames(rep(0, 5), MODEL_NAMES)
  if (nrow(results) > 0) {
    wm <- tapply(results$AUC, results$Model, mean, na.rm = TRUE)
    w_full[names(wm)] <- wm
  }
  if (sum(w_full) == 0) w_full[] <- 1
  cat("\n  Ensemble weights (AUC-based):\n"); print(round(w_full / sum(w_full), 4))
  write.csv(data.frame(Model = MODEL_NAMES, AUC_mean = as.numeric(w_full),
                       Weight = round(as.numeric(w_full / sum(w_full)), 4)),
            paste0(dir, "Ensemble_weights.csv"), row.names = FALSE)
  
  # OOF ensemble with leave-one-fold-out weights (fold i's own AUC never sets its weights)
  write.csv(do.call(rbind, lapply(1:5, function(i) data.frame(
    Predicted_fold = i, Model = MODEL_NAMES,
    Weight = round(as.numeric(lofo_weights(results, i) / sum(lofo_weights(results, i))), 4)))),
    paste0(dir, "Ensemble_weights_LOFO_per_fold.csv"), row.names = FALSE)
  ens_oof <- oof_ensemble_lofo(oof, folds, results)
  ev_all  <- ens_eval(dat$presence, ens_oof)
  ev_fld  <- ens_eval(dat$presence[is_field], ens_oof[is_field])
  cat(sprintf("  Ensemble OOF: AUC=%.3f | max-TSS threshold=%.3f (TSS_opt=%.3f, optimistic) | field-only AUC=%.3f\n",
              ev_all$auc, ev_all$thr, ev_all$tss, ev_fld$auc))
  write.csv(data.frame(Set = c("All rows","Field presence vs field non-detection"),
                       OOF_AUC_primary = c(ev_all$auc, ev_fld$auc),
                       Operational_threshold_maxTSS = c(ev_all$thr, ev_fld$thr),
                       TSS_at_optimised_threshold = c(ev_all$tss, ev_fld$tss),
                       Note = "TSS is computed at a threshold optimised on the same OOF predictions; not independent. Report AUC as primary metric."),
            paste0(dir, "Ensemble_OOF_performance.csv"), row.names = FALSE)
  fo <- do.call(rbind, lapply(c(MODEL_NAMES, "Ensemble"), function(m) {
    pr <- if (m == "Ensemble") ens_oof else oof[, m]
    f <- function(idx) {
      ok <- idx & !is.na(pr)
      if (sum(ok) < 10 || length(unique(dat$presence[ok])) < 2) return(c(NA, NA, NA, sum(ok), NA))
      r <- pROC::roc(dat$presence[ok], pr[ok], levels = c(0, 1), direction = "<", quiet = TRUE)
      ci <- as.numeric(pROC::ci.auc(r)); c(ci[2], ci[1], ci[3], sum(ok), sum(dat$presence[ok] == 1))
    }
    a <- f(rep(TRUE, n)); b <- f(is_field)
    data.frame(Model = m, AUC_all = round(a[1], 3), AUC_all_lo = round(a[2], 3), AUC_all_hi = round(a[3], 3),
               AUC_field_only = round(b[1], 3), AUC_field_lo = round(b[2], 3), AUC_field_hi = round(b[3], 3),
               n_field = b[4], n_field_presences = b[5])
  }))
  cat("\n  === OOF AUC: all records vs FIELD-ONLY (presence vs field non-detection), 95% DeLong CI ===\n")
  print(fo, row.names = FALSE)
  write.csv(fo, paste0(dir, "OOF_AUC_all_vs_field_only.csv"), row.names = FALSE)
  
  # ---- final models (full-data VIF + scaling) ----
  cat("\n  Final models...\n")
  pf_full <- prep_fold(dat, dat)
  cat("  Final VIF-retained:", paste(pf_full$vars, collapse = ", "), "\n")
  write.csv(rbind(data.frame(Variable = pf_full$vars, Status = "Retained"),
                  data.frame(Variable = setdiff(ALL_VARS, pf_full$vars), Status = "Excluded (VIF>5)")),
            paste0(dir, "VIF_selection_table.csv"), row.names = FALSE)
  write.csv(pf_full$vif@results, paste0(dir, "VIF_results.csv"), row.names = FALSE)
  write.csv(data.frame(Variable = pf_full$vars, Mean = pf_full$mu, SD = pf_full$sd),
            paste0(dir, "Predictor_scaler.csv"), row.names = FALSE)
  fm_final <- fit_models(pf_full$train_sc, dat, pf_full$vars, paste0(dir, "maxent_final/"), full = TRUE)
  
  # ---- maps ----
  cat("  Maps (relative suitability index)...\n")
  env_sc <- env[[pf_full$vars]]
  for (v in pf_full$vars)
    env_sc[[v]] <- (env_sc[[v]] - unname(pf_full$mu[v])) / unname(pf_full$sd[v])
  
  maps <- list()
  add_map <- function(nm, expr) {
    r <- tryCatch(expr, error = function(e) { cat("   Map", nm, "failed:", e$message, "\n"); NULL })
    if (!is.null(r)) {
      names(r) <- nm; r <- mask(r, vect(wg))
      writeRaster(r, paste0(dir, "Map_", nm, ".tif"), overwrite = TRUE)
      maps[[nm]] <<- r
    }
  }
  if (!is.null(fm_final$glm))  add_map("GLM",  predict(env_sc, fm_final$glm, type = "response"))
  if (!is.null(fm_final$rf))   add_map("RF",   predict(env_sc, fm_final$rf, type = "prob")[[2]])
