cat("\n[9/9] Moran's I on OOF residuals...\n")
morans_test <- function(label, obs, pred, coords_df) {
  ok <- !is.na(pred); if (sum(ok) < 30) return(NULL)
  tryCatch({
    resid <- obs[ok] - pred[ok]
    nb  <- knn2nb(knearneigh(as.matrix(coords_df[ok, ]), k = 5))
    mt  <- moran.test(resid, nb2listw(nb, style = "W"))
    data.frame(Model = label, n = sum(ok),
               Morans_I = round(unname(mt$estimate["Moran I statistic"]), 5),
               Expected = round(unname(mt$estimate["Expectation"]), 5),
               Variance = round(unname(mt$estimate["Variance"]), 8),
               p_value = round(mt$p.value, 5),
               Weights = "5-nearest-neighbour, row-standardised (projected coordinates)",
               Interpretation = ifelse(mt$p.value < 0.05, "Significant spatial autocorrelation (p<0.05)",
                                       "No significant spatial autocorrelation (p>=0.05)"))
  }, error = function(e) { cat("  Moran [", label, "]:", e$message, "\n"); NULL })
}
cd <- sc_main$dat[, c("x","y")]
