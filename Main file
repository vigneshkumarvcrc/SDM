rc_bootstrap <- function(final_mod, predict_fn, data, var_list, n_boot = 50, n_pts = 100) {
  rc_all <- data.frame()
  for (vname in var_list) {
    vr <- range(data[[vname]], na.rm = TRUE); if (diff(vr) == 0) next
    var_seq <- seq(vr[1], vr[2], length.out = n_pts)
    base_row <- data[1, , drop = FALSE]
    for (v in names(data)) if (is.numeric(data[[v]])) base_row[[v]] <- median(data[[v]], na.rm = TRUE)
    boot_mat <- matrix(NA_real_, n_pts, n_boot)
    for (b in seq_len(n_boot)) {
      idx <- sample(nrow(data), replace = TRUE)
      bm  <- tryCatch(update(final_mod, data = data[idx, ]), error = function(e) NULL)
      if (is.null(bm)) next
      for (j in seq_along(var_seq)) {
        tmp <- base_row; tmp[[vname]] <- var_seq[j]
        boot_mat[j, b] <- tryCatch(predict_fn(bm, tmp), error = function(e) NA_real_)
      }
    }
    rc_all <- rbind(rc_all, data.frame(Variable = vname, x = var_seq,
                                       mean = rowMeans(boot_mat, na.rm = TRUE),
                                       lower = apply(boot_mat, 1, quantile, 0.025, na.rm = TRUE),
                                       upper = apply(boot_mat, 1, quantile, 0.975, na.rm = TRUE)))
  }
  rc_all
}

plot_rc_boot <- function(rc_df, title_str, fname, col = "steelblue") {
  if (nrow(rc_df) == 0) return(invisible())
  write.csv(rc_df, paste0(out, sub("\\.png$", "_data.csv", fname)), row.names = FALSE)   # for figure script
