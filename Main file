CAL_MIN_N <- 10   # bins with fewer observations are drawn hollow = unreliable

wilson_ci <- function(k, n, z = 1.96) {
  p <- k / n; den <- 1 + z^2 / n
  cen <- (p + z^2 / (2 * n)) / den; half <- z * sqrt(p * (1 - p) / n + z^2 / (4 * n^2)) / den
  cbind(lo = pmax(0, cen - half), hi = pmin(1, cen + half))
}
cal_bins <- function(obs, pred, model, breaks = seq(0, 1, 0.1)) {
  ok <- !is.na(pred) & !is.na(obs)
  if (sum(ok) < 20) return(NULL)
  d <- data.frame(obs = obs[ok], pred = pred[ok])
  d$bin <- cut(d$pred, breaks, include.lowest = TRUE)
  b <- d %>% dplyr::group_by(bin) %>%
    dplyr::summarise(mean_pred = mean(pred), n = dplyr::n(), n_pres = sum(obs == 1), .groups = "drop")
  b$obs_prop <- b$n_pres / b$n
  ci <- wilson_ci(b$n_pres, b$n); b$lo <- ci[, "lo"]; b$hi <- ci[, "hi"]
  b$reliable <- b$n >= CAL_MIN_N
  b$bin <- as.character(b$bin); b$Model <- model; b$prevalence_design <- mean(d$obs == 1)
  as.data.frame(b)
}

# Interpretation: x = relative suitability index (NOT a calibrated probability); y = share of presence records
# among the records in the bin, which depends on the presence:zero ratio of the design. A 1:1 line is therefore
# NOT drawn; the dotted line is the overall presence share (what a model with no discrimination would give).
calibration_plot <- function(obs, pred, name) {
  b <- cal_bins(obs, pred, name)
  if (is.null(b) || nrow(b) < 2) { cat("  Skip calibration [", name, "]\n"); return(invisible(NULL)) }
  p <- ggplot(b, aes(mean_pred, obs_prop)) +
    geom_hline(yintercept = b$prevalence_design[1], linetype = "dotted", colour = "grey40") +
    geom_errorbar(aes(ymin = lo, ymax = hi), width = 0.015, colour = "steelblue", alpha = 0.8) +
    geom_point(aes(size = n, shape = factor(reliable, levels = c(TRUE, FALSE))), colour = "steelblue") +
    scale_shape_manual(values = c(`TRUE` = 16, `FALSE` = 1), labels = c(paste0("n >= ", CAL_MIN_N), paste0("n < ", CAL_MIN_N)),
                       name = "Observations in bin", drop = FALSE) +
    scale_size_continuous(range = c(1.5, 6), name = "n in bin") +
    coord_cartesian(xlim = c(0, 1), ylim = c(0, 1)) +
    labs(title = paste("Out-of-fold calibration —", name, "|", SPECIES),
         subtitle = "Bars = 95% Wilson intervals; dotted = overall presence share of the modelling data (no-skill reference).\nIndex is a relative suitability index, not a probability; do not rank algorithms from this plot.",
         x = "Mean out-of-fold relative suitability index (bin)", y = "Observed share of presence records in bin") +
    theme_bw(base_size = 12) + theme(plot.title = element_text(face = "bold"), plot.subtitle = element_text(size = 8))
  save_gg(p, paste0(out, "Calibration_OOF_", name, ".png"), 6.5, 5.5)
  invisible(b)
}
