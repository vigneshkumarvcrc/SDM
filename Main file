aggregate_to_1km <- function(r, tmpl, fun = "mean") {
  if (res(r)[1] < res(tmpl)[1]) {
    fact <- max(1L, round(res(tmpl)[1] / res(r)[1]))
    cat("  aggregate:", names(r), "| factor =", fact, "\n")
    r <- aggregate(r, fact = fact, fun = fun)
  }
  resample(r, tmpl, method = "bilinear")
}

