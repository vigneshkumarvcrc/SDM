# Plot saving -----------------------------------------------------------------
DPI <- 500

save_gg <- function(plot_obj, filename, width = 8, height = 6, dpi = DPI) {
  tryCatch(
    ggsave(filename = filename, plot = plot_obj,
           width = width, height = height, units = "in", dpi = dpi, bg = "white"),
    error = function(e) cat("  Plot error [", basename(filename), "]:", e$message, "\n"))
  cat("  Saved:", basename(filename), "\n")
}

save_base <- function(filename, width = 8, height = 8, dpi = DPI, expr) {
  png(filename, width = width, height = height, units = "in", res = dpi)
  tryCatch({ force(expr); invisible(NULL) },
           error   = function(e) cat("  Plot error [", basename(filename), "]:", e$message, "\n"),
           finally = { if (dev.cur() > 1) dev.off() })
  cat("  Saved:", basename(filename), "\n")
}


