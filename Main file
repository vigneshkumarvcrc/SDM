    geom_raster(data = ov_df, aes(x, y, fill = class_label)) +
    scale_fill_manual(values = c("Neither" = "grey92", "H. spinigera only" = "#1f78b4",
                                 "H. turturis only" = "#33a02c", "Both species" = "#e31a1c"),
                      name = "Predicted habitat") +
    labs(title = "Haemaphysalis spp. — Predicted suitability overlap",
         subtitle = paste0("Both = ", ov_stats$Area_km2[4], " km2 (", ov_stats$Pct_common_WG[4],
                           "% of common WG area)")) +
    theme_bw(base_size = 13) + theme(legend.position = "bottom", plot.title = element_text(face = "bold"))
  save_gg(p_ov, paste0(out, "Map_species_overlap_plot.png"), 7, 9)
  
  perf1 <- tryCatch(read.csv(paste0(out_sp1, "Model_summary_table.csv")) %>% dplyr::mutate(Species = "H. spinigera"), error = function(e) NULL)
  perf2 <- tryCatch(read.csv(paste0(out_sp2, "Model_summary_table.csv")) %>% dplyr::mutate(Species = "H. turturis"), error = function(e) NULL)
  if (!is.null(perf1) && !is.null(perf2)) {
    pb <- rbind(perf1, perf2)
    write.csv(pb, paste0(out, "Species_model_comparison.csv"), row.names = FALSE)
    p_comp <- ggplot(pb, aes(Model, AUC_mean, fill = Species, ymin = AUC_mean - AUC_SD, ymax = AUC_mean + AUC_SD)) +
      geom_bar(stat = "identity", position = position_dodge(0.7), width = 0.6, colour = "white") +
      geom_errorbar(position = position_dodge(0.7), width = 0.2, linewidth = 0.7) +
      scale_fill_manual(values = c("H. spinigera" = "#1f78b4", "H. turturis" = "#33a02c")) +
      scale_y_continuous(limits = c(0, 1.05), breaks = seq(0, 1, 0.1)) +
      geom_hline(yintercept = 0.7, linetype = "dashed", colour = "red") +
      labs(title = "Model Performance — H. spinigera vs H. turturis",
           subtitle = "AUC mean \u00b1 SD across 5 spatial CV folds", x = NULL, y = "AUC") +
      theme_bw(base_size = 13) + theme(legend.position = "bottom", plot.title = element_text(face = "bold"))
    save_gg(p_comp, paste0(out, "Species_AUC_comparison.png"), 8, 5)
  }
} else cat("  Run both species first\n")




